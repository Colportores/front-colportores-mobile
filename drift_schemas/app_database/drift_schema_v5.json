  "fixed_sql": [
    {
      "name": "jornada",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"jornada\" (\"id\" TEXT NOT NULL, \"colportor_id\" TEXT NOT NULL, \"inicio\" INTEGER NOT NULL, \"fin\" INTEGER NULL, \"acompaniante_id\" TEXT NULL, \"tipo_acompaniamiento\" TEXT NULL, \"total_visitas\" INTEGER NOT NULL DEFAULT 0, \"total_ventas\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"created_by\" TEXT NULL, \"deleted_at\" INTEGER NULL, \"sync_version\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"), CHECK (total_visitas >= 0), CHECK (total_ventas >= 0), CHECK (fin IS NULL OR fin >= inicio));"
        }
      ]
    },
    {
      "name": "ubicacion",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ubicacion\" (\"id\" TEXT NOT NULL, \"tipo\" TEXT NOT NULL, \"calle\" TEXT NULL, \"numero\" TEXT NULL, \"lat\" REAL NOT NULL, \"lon\" REAL NOT NULL, \"ciudad_id\" TEXT NOT NULL, \"zona_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"created_by\" TEXT NULL, \"deleted_at\" INTEGER NULL, \"sync_version\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"), CHECK (tipo IN ('CASA', 'NEGOCIO', 'EDIFICIO')), CHECK (lat BETWEEN -90 AND 90), CHECK (lon BETWEEN -180 AND 180));"
        }
      ]
    },
    {
      "name": "espacio",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"espacio\" (\"id\" TEXT NOT NULL, \"ubicacion_id\" TEXT NOT NULL, \"numero_depto\" TEXT NULL, \"piso\" TEXT NULL, \"descripcion\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"created_by\" TEXT NULL, \"deleted_at\" INTEGER NULL, \"sync_version\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "ubicacion_par_decidido",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ubicacion_par_decidido\" (\"ubicacion_a_id\" TEXT NOT NULL, \"ubicacion_b_id\" TEXT NOT NULL, \"decision\" TEXT NOT NULL, \"decidido_en\" INTEGER NOT NULL, PRIMARY KEY (\"ubicacion_a_id\", \"ubicacion_b_id\"), CHECK (decision IN ('CONSERVAR_AMBOS', 'IGNORAR')), CHECK (ubicacion_a_id < ubicacion_b_id));"
        }
      ]
    },
    {
      "name": "campania_ciudad",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"campania_ciudad\" (\"id\" TEXT NOT NULL, \"campania_id\" TEXT NOT NULL, \"ciudad_id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"created_by\" TEXT NULL, \"deleted_at\" INTEGER NULL, \"sync_version\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "zona",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"zona\" (\"id\" TEXT NOT NULL, \"nombre\" TEXT NOT NULL, \"campania_ciudad_id\" TEXT NOT NULL, \"tipo_forma\" TEXT NOT NULL, \"centro_lat\" REAL NULL, \"centro_lon\" REAL NULL, \"radio_m\" INTEGER NULL, \"poligono_geojson\" TEXT NOT NULL, \"color\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"created_by\" TEXT NULL, \"deleted_at\" INTEGER NULL, \"sync_version\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"), CHECK (tipo_forma IN ('RADIAL', 'ESQUINAS')), CHECK (tipo_forma <> 'RADIAL' OR (centro_lat IS NOT NULL AND centro_lon IS NOT NULL AND radio_m IS NOT NULL)), CHECK (radio_m IS NULL OR radio_m BETWEEN 1 AND 3000), CHECK ((centro_lat IS NULL OR centro_lat BETWEEN -90 AND 90) AND (centro_lon IS NULL OR centro_lon BETWEEN -180 AND 180)), CHECK (color IS NULL OR color GLOB '#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]'));"
        }
      ]
