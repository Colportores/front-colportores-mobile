<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Red. Flutter la declara solo en los manifiestos de debug y profile (para el hot reload);
         sin esta línea una build de release no sale a internet: ni Supabase, ni los mosaicos del
         mapa del alta de ubicación, ni la dirección del punto. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GPS del alta de ubicación (HU-UBI-001). Solo mientras la app está abierta: no hay
         ubicación en segundo plano. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notificaciones (HU-NOT-001, vista 24). Android 13 o más pide este permiso en tiempo de
         ejecución, en el primer ingreso; sin esta línea el sistema ni muestra el diálogo. Los
         recordatorios de las visitas (HU-NOT-002) y las push (HU-NOT-003) lo necesitan. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Recordatorios de las visitas (HU-NOT-002): al reiniciar el teléfono Android borra las
         alarmas, y con este permiso el plugin vuelve a programar los avisos que seguían pendientes.
         No se pide la alarma exacta (SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM): ver el PR. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Auto Backup deshabilitado a propósito. Dos motivos, ninguno negociable:
         1. flutter_secure_storage (README 10.3.1, "Disabling Auto Backup") lo exige: el plugin
            guarda el ciphertext en SharedPreferences —que Auto Backup sube a Drive— y la clave
            que lo envuelve en el Keystore, que no se respalda. Tras un restore en otro equipo la
            lectura falla ("Failed to unwrap key") y, con resetOnError=true, la sal se devuelve
            como null en silencio.
         2. La DB SQLCipher con persona/nota es local-only (02-restricciones.md, R-PV-02): nunca
            sale del dispositivo. La única vía para moverla a otro equipo es el backup E2E con la
            contraseña del usuario (ADR-003), no el backup de Android.
         allowBackup="false" cubre cloud en todas las API; dataExtractionRules cubre además la
         transferencia dispositivo-a-dispositivo en API 31+, donde allowBackup no alcanza en
         todos los fabricantes. -->
    <application
        android:label="colportores_mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- Solo vertical (decisión de Cristian del 07/10, #301): la misma regla que Info.plist y
             que SystemChrome.setPreferredOrientations en main.dart. Android 16 la ignora en
             pantallas de 600 dp o más (tablets); los teléfonos la respetan. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link de los enlaces del correo (verificación de email, HU-AUTH-002, y
                 recuperación de contraseña, HU-AUTH-004/005). Lo captura app_links (viene con
                 supabase_flutter) y supabase_flutter completa la sesión. La MISMA URL
                 —io.supabase.colportores://login-callback/— tiene que estar en
                 ConfigSupabase.redirectBase y en el dashboard de Supabase:
                 Authentication → URL Configuration → Redirect URLs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="io.supabase.colportores" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Recordatorios de las visitas (HU-NOT-002), de flutter_local_notifications: el primero
             muestra el aviso a su hora; el segundo reprograma los pendientes tras reiniciar o
             actualizar la app. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
