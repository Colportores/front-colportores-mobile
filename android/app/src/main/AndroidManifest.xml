<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Auto Backup deshabilitado a propósito. Dos motivos, ninguno negociable:
         1. flutter_secure_storage (README 10.3.1, "Disabling Auto Backup") lo exige: el plugin
            guarda el ciphertext en SharedPreferences —que Auto Backup sube a Drive— y la clave
            que lo envuelve en el Keystore, que no se respalda. Tras un restore en otro equipo la
            lectura falla ("Failed to unwrap key") y, con resetOnError=true, la sal se devuelve
            como null en silencio.
         2. La DB SQLCipher con persona/nota es local-only (02-restricciones.md, R-PV-02): nunca
            sale del dispositivo. La única vía para moverla a otro equipo es el backup E2E con la
            contraseña del usuario (ADR-003), no el backup de Android.
         allowBackup="false" cubre cloud en todas las API; dataExtractionRules cubre además la
         transferencia dispositivo-a-dispositivo en API 31+, donde allowBackup no alcanza en
         todos los fabricantes. -->
    <application
        android:label="colportores_mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link de vuelta del OAuth por navegador (Google, HU-AUTH-003). Lo captura
                 app_links (viene con supabase_flutter) y supabase_flutter completa la sesión.
                 La MISMA URL —io.supabase.colportores://login-callback/— tiene que estar en
                 ConfigSupabase.redirectOAuth y en el dashboard de Supabase:
                 Authentication → URL Configuration → Redirect URLs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="io.supabase.colportores" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
